PORT=5000
# Local MongoDB, or a MongoDB Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/hously_crm
# Use a long random string in real deployments
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Demo only: when set, this fixed code is used for password reset and returned in the response
# (no email service is wired up). Leave empty to get a random code printed in the server log.
DEMO_RESET_CODE=123456
# Minutes ahead of UTC used for "today" on follow-ups (330 = India, IST)
TZ_OFFSET_MINUTES=330
CORS_ORIGIN=*
